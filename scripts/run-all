#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shared="$here/TestRunner/shared"
[ -x "$shared/bin/run-all" ] || { echo "run-all: the shared runner is missing; run: git submodule update --init" >&2; exit 4; }
export RIMHUNTER_MOD_REPO="$here"
case " $* " in
  *" --list-launches "*) ;;
  *) if [ -n "${RIMHUNTER_FACTIONALWAR_SRC:-}" ] || [ ! -d "$here/external/factional-war" ]; then "$here/scripts/prepare-factional-war" >&2; fi ;;
esac
exec "$shared/bin/run-all" "$@"
