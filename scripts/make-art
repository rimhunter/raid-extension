#!/usr/bin/env python3
import math
import os
import sys
from PIL import Image, ImageDraw, ImageFont

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FONT = "/usr/share/fonts/open-sans/OpenSans-Bold.ttf"

GREEN = (0, 158, 115, 255)
DEEP = (0, 96, 70, 255)
ORANGE = (230, 159, 0, 255)
SKY = (86, 180, 233, 255)
RED = (213, 94, 0, 255)
INK = (24, 28, 34, 255)
PAPER = (240, 234, 214, 255)
STEEL = (200, 206, 214, 255)
SKIN = (236, 200, 160, 255)
BARK = (140, 96, 58, 255)
FUR = (176, 124, 72, 255)


class Pen:
    def __init__(self, w, h, scale):
        self.s = scale
        self.im = Image.new("RGBA", (w * scale, h * scale), (0, 0, 0, 0))
        self.d = ImageDraw.Draw(self.im)

    def _pts(self, pts):
        return [(x * self.s, y * self.s) for x, y in pts]

    def poly(self, pts, fill, outline=INK, width=2):
        p = self._pts(pts)
        self.d.polygon(p, fill=fill)
        self.d.line(p + [p[0]], fill=outline, width=int(width * self.s), joint="curve")

    def rect(self, x0, y0, x1, y1, fill, outline=INK, width=2):
        self.d.rectangle([x0 * self.s, y0 * self.s, x1 * self.s, y1 * self.s], fill=fill, outline=outline, width=int(width * self.s))

    def circle(self, cx, cy, r, fill=None, outline=INK, width=2):
        self.d.ellipse([(cx - r) * self.s, (cy - r) * self.s, (cx + r) * self.s, (cy + r) * self.s], fill=fill, outline=outline, width=int(width * self.s) if outline else 0)

    def ellipse(self, cx, cy, rx, ry, fill, outline=INK, width=2):
        self.d.ellipse([(cx - rx) * self.s, (cy - ry) * self.s, (cx + rx) * self.s, (cy + ry) * self.s], fill=fill, outline=outline, width=int(width * self.s))

    def line(self, a, b, fill, width):
        self.d.line(self._pts([a, b]), fill=fill, width=int(width * self.s))


def tree(p, cx, base, h):
    p.rect(cx - h * 0.05, base - h * 0.25, cx + h * 0.05, base, BARK, width=3)
    for i, (w, top, bot) in enumerate(((0.34, 0.95, 0.55), (0.28, 0.75, 0.38), (0.2, 0.55, 0.22))):
        p.poly([(cx - h * w, base - h * bot + h * 0.12), (cx, base - h * top), (cx + h * w, base - h * bot + h * 0.12)], GREEN if i != 1 else DEEP, width=3)


def stump(p, cx, base, w):
    p.rect(cx - w / 2, base - w * 0.5, cx + w / 2, base, BARK, width=3)
    p.ellipse(cx, base - w * 0.5, w / 2, w * 0.14, PAPER, width=3)


def person(p, cx, base, h, body):
    w = h * 0.5
    p.rect(cx - w / 2, base - h * 0.62, cx + w / 2, base, body)
    p.rect(cx - w * 0.36, base - h * 0.99, cx + w * 0.36, base - h * 0.66, SKIN)


def axe(p, x, y, length):
    p.line((x, y), (x + length * 0.5, y - length), BARK, 9)
    p.poly([(x + length * 0.5 - 4, y - length), (x + length * 0.5 + 34, y - length - 14), (x + length * 0.5 + 34, y - length + 28), (x + length * 0.5 - 4, y - length + 14)], STEEL, width=3)


def deer(p, cx, base, h):
    p.ellipse(cx, base - h * 0.5, h * 0.42, h * 0.2, FUR, width=3)
    for dx in (-0.28, -0.16, 0.16, 0.28):
        p.line((cx + dx * h, base - h * 0.4), (cx + dx * h, base), INK, 7)
    p.line((cx + h * 0.32, base - h * 0.6), (cx + h * 0.5, base - h * 0.9), FUR, 16)
    p.ellipse(cx + h * 0.55, base - h * 0.92, h * 0.12, h * 0.08, FUR, width=3)
    for s in (-1, 1):
        a = (cx + h * 0.5, base - h * 1.0)
        p.line(a, (a[0] + s * h * 0.18, a[1] - h * 0.26), INK, 6)
        p.line((a[0] + s * h * 0.09, a[1] - h * 0.13), (a[0] + s * h * 0.26, a[1] - h * 0.2), INK, 5)


def bow(p, cx, cy, r):
    steps = 14
    pts = [(cx + math.cos(math.radians(-70 + 140 * i / steps)) * r * 0.6, cy + math.sin(math.radians(-70 + 140 * i / steps)) * r) for i in range(steps + 1)]
    for a, b in zip(pts, pts[1:]):
        p.line(a, b, BARK, 7)
    p.line(pts[0], pts[-1], STEEL, 3)


def wagon(p, cx, base, w):
    p.rect(cx - w / 2, base - w * 0.45, cx + w / 2, base - w * 0.12, ORANGE, width=4)
    p.poly([(cx - w * 0.45, base - w * 0.45), (cx - w * 0.3, base - w * 0.75), (cx + w * 0.3, base - w * 0.75), (cx + w * 0.45, base - w * 0.45)], PAPER, width=4)
    for dx in (-0.28, 0.28):
        p.circle(cx + dx * w, base - w * 0.1, w * 0.12, fill=BARK, width=4)
        p.circle(cx + dx * w, base - w * 0.1, w * 0.04, fill=INK, outline=None)


def preview():
    W, H, S = 1024, 576, 2
    base = Image.new("RGBA", (W * S, H * S), (0, 0, 0, 255))
    d = ImageDraw.Draw(base)
    for y in range(H * S):
        t = y / (H * S)
        d.line([(0, y), (W * S, y)], fill=(int(30 + 70 * t), int(40 + 40 * t), int(64 - 10 * t), 255))
    d.rectangle([0, 384 * S, W * S, H * S], fill=(18, 22, 26, 255))
    d.line([(0, 384 * S), (W * S, 384 * S)], fill=PAPER, width=3 * S)

    p = Pen(W, H, S)
    for x in (30, 110, 190):
        tree(p, x, 370, 210 if x != 110 else 250)
    stump(p, 250, 378, 46)
    person(p, 320, 378, 120, RED)
    axe(p, 345, 330, 100)
    deer(p, 530, 378, 150)
    person(p, 700, 378, 120, RED)
    bow(p, 724, 318, 52)
    wagon(p, 860, 378, 190)
    person(p, 975, 378, 110, SKY)
    im = Image.alpha_composite(base, p.im)

    d = ImageDraw.Draw(im)
    title = ImageFont.truetype(FONT, 92 * S)
    sub = ImageFont.truetype(FONT, 36 * S)
    for text, font, y, fill in (("Raid Extension", title, 396, PAPER), ("for RimWorld 1.6 and 1.7", sub, 508, STEEL)):
        x = (W * S - d.textlength(text, font=font)) / 2
        d.text((x + 4 * S, y * S + 4 * S), text, font=font, fill=(0, 0, 0, 255))
        d.text((x, y * S), text, font=font, fill=fill)
    im.convert("RGB").resize((W, H), Image.LANCZOS).save(os.path.join(HERE, "About", "Preview.png"), optimize=True)


if __name__ == "__main__":
    if not os.path.isfile(FONT):
        sys.exit("make-art: the font %s is missing" % FONT)
    preview()
